{
  "manifest_version": 3,
  "name": "EnVi Dictionary",
  "version": "1.0.0",
  "description": "Tra từ Anh-Việt: giữ Alt rồi bôi đen một từ tiếng Anh.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.dictionaryapi.dev/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "css": ["content.css"],
    "all_frames": true
  }],
  "web_accessible_resources": [{ "resources": ["popup-card.css"], "matches": ["<all_urls>"] }],
  "action": { "default_popup": "popup.html", "default_title": "EnVi Dictionary" }
}
